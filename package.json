    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint src/ test/",
    "test": "bun test",
    "test:money": "bun test src/shared/domain/money.spec.ts",
    "test:wallet": "bun test src/shared/domain/wallet.spec.ts",
    "test:ledger": "bun test src/shared/domain/wallet-ledger-entry.spec.ts",
    "test:wager": "bun test src/shared/domain/wager-transaction.spec.ts",
    "test:database": "RUN_DATABASE_TESTS=1 bun test test/database-constraints.spec.ts",
    "test:repositories": "RUN_REPOSITORY_TESTS=1 bun test test/repositories.spec.ts",
    "test:open-wallet": "RUN_OPEN_WALLET_TESTS=1 bun test test/open-wallet.spec.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:reset": "docker compose down -v"
  },
